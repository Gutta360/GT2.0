# Copy only through prepare-host.sh. Never commit or print real values.
GT2_DB_URL=jdbc:postgresql://127.0.0.1:5432/gt2
GT2_DB_USERNAME=gt2_app
GT2_DB_PASSWORD=generated-on-server
GT2_ADMIN_TOKEN=generated-on-server
GT2_SNAPSHOT_MASTER_KEY=generated-on-server
GT2_SNAPSHOT_STORAGE=/var/lib/gt2/snapshots
GT2_ALLOWED_ORIGINS=https://localhost
GT2_SERVER_PORT=8091
GT2_SERVER_ADDRESS=127.0.0.1
GT2_ENROLLMENT_TTL=PT30M
GT2_MAX_BATCH_SIZE=100
GT2_MAX_SNAPSHOT_BYTES=10485760
GT2_SNAPSHOT_RETENTION_COUNT=5
